# ====================================================================
#  FRONTEND .dockerignore  – keep the Docker build context small
# ====================================================================

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Git / CI metadata ---
.git/
.gitignore
.github/
.gitlab-ci.yml
.travis.yml
.circleci/
.husky/

# --- Render files (if any) ---
render.yaml
render.yml

# --- Node / Angular build output & node_modules (reinstalled fresh) ---
node_modules/
dist/
.tmp/
.angular/
.cache/

# --- Local env / config secrets ---
.env
.env.*
environment.local.ts
*.local.ts

# --- Playwright / tests ---
.playwright-browsers/
playwright-report/
test-results/
e2e/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
